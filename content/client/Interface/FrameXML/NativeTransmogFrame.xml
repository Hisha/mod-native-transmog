<?xml version="1.0" encoding="utf-8"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Script file="NativeTransmogFrame.lua" />

  <!-- ItemButtonTemplate supplies Blizzard's 37px icon, count, normal border, and highlight conventions.
       The wardrobe owns only selection and confirmed-override markers; it intentionally does not inherit
       PaperDollItemSlotButtonTemplate's CharacterFrame equip, drag, event, or flyout handlers. -->
  <Button name="NativeTransmogEquipmentSlotTemplate" inherits="ItemButtonTemplate" virtual="true">
    <Size x="40" y="40" />
    <Layers>
      <Layer level="OVERLAY">
        <Texture name="$parentSelection" file="Interface\Buttons\CheckButtonHilight" alphaMode="ADD" hidden="true">
          <Size x="50" y="50" /><Anchors><Anchor point="CENTER" /></Anchors>
        </Texture>
        <Texture name="$parentTransmogMark" file="Interface\RaidFrame\ReadyCheck-Ready" hidden="true">
          <Size x="15" y="15" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-1" y="1" /></Anchor></Anchors>
        </Texture>
        <Texture name="$parentHiddenMark" file="Interface\Buttons\UI-GroupLoot-Pass-Up" hidden="true">
          <Size x="17" y="17" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="0" y="0" /></Anchor></Anchors>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>NativeTransmog_EquipmentSlot_OnLoad(self);</OnLoad>
      <OnClick>NativeTransmog_EquipmentSlot_OnClick(self);</OnClick>
      <OnEnter>NativeTransmog_EquipmentSlot_OnEnter(self);</OnEnter>
      <OnLeave>NativeTransmog_EquipmentSlot_OnLeave(self);</OnLeave>
    </Scripts>
  </Button>

  <Frame name="NativeTransmogFrame" parent="UIParent" hidden="true"
      enableMouse="true" movable="true" frameStrata="DIALOG" toplevel="true">
    <Size x="900" y="540" />
    <Anchors><Anchor point="CENTER" /></Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
        edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11" /></BackgroundInsets>
      <TileSize><AbsValue val="32" /></TileSize>
      <EdgeSize><AbsValue val="32" /></EdgeSize>
    </Backdrop>
    <Layers>
      <Layer level="BORDER">
        <Texture name="$parentHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
          <Size x="420" y="64" />
          <Anchors><Anchor point="TOP"><Offset x="0" y="12" /></Anchor></Anchors>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" inherits="GameFontNormal" text="WARDROBE">
          <Anchors><Anchor point="TOP"><Offset x="0" y="-8" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentSlotTitle" inherits="GameFontNormalLarge" justifyH="LEFT">
          <Size x="405" y="22" /><Anchors><Anchor point="TOPLEFT"><Offset x="460" y="-47" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentHint" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP"
            text="Preview is local. Changes wait for server confirmation.">
          <Size x="405" y="18" /><Anchors><Anchor point="TOPLEFT"><Offset x="460" y="-72" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentActual" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size x="405" y="14" /><Anchors><Anchor point="TOPLEFT"><Offset x="460" y="-92" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentApplied" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size x="405" y="14" /><Anchors><Anchor point="TOPLEFT"><Offset x="460" y="-106" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentPreview" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size x="405" y="14" /><Anchors><Anchor point="TOPLEFT"><Offset x="460" y="-120" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentStatus" inherits="GameFontNormalSmall" justifyH="CENTER">
          <Size x="410" y="18" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-20" y="16" /></Anchor></Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
        <Anchors><Anchor point="TOPRIGHT"><Offset x="-5" y="-5" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmogFrame:Hide();</OnClick></Scripts>
      </Button>

      <Frame name="$parentPreviewPanel">
        <Size x="420" y="452" />
        <Anchors><Anchor point="TOPLEFT"><Offset x="20" y="-45" /></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4" /></BackgroundInsets>
          <TileSize><AbsValue val="16" /></TileSize>
          <EdgeSize><AbsValue val="16" /></EdgeSize>
        </Backdrop>
        <Frames>
          <DressUpModel name="$parentModel" enableMouse="true" enableMouseWheel="true">
            <Size x="286" y="342" />
            <Anchors><Anchor point="TOP"><Offset x="0" y="-20" /></Anchor></Anchors>
            <Scripts>
              <OnMouseDown>NativeTransmog_BeginRotation(self);</OnMouseDown>
              <OnMouseUp>NativeTransmog_EndRotation(self);</OnMouseUp>
              <OnHide>NativeTransmog_EndRotation(self);</OnHide>
              <OnUpdate>NativeTransmog_UpdateRotation(self);</OnUpdate>
              <OnMouseWheel>NativeTransmog_Rotate(delta * .12);</OnMouseWheel>
            </Scripts>
          </DressUpModel>

          <!-- Left paper-doll column. -->
          <Button name="$parentHeadSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="1">
            <Anchors><Anchor point="TOPLEFT"><Offset x="13" y="-20" /></Anchor></Anchors>
          </Button>
          <Button name="$parentShoulderSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="2">
            <Anchors><Anchor point="TOP" relativeTo="$parentHeadSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentBackSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="10">
            <Anchors><Anchor point="TOP" relativeTo="$parentShoulderSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentChestSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="4">
            <Anchors><Anchor point="TOP" relativeTo="$parentBackSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentShirtSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="3">
            <Anchors><Anchor point="TOP" relativeTo="$parentChestSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentTabardSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="14">
            <Anchors><Anchor point="TOP" relativeTo="$parentShirtSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>

          <!-- Right paper-doll column. -->
          <Button name="$parentWristSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="8">
            <Anchors><Anchor point="TOPRIGHT"><Offset x="-13" y="-20" /></Anchor></Anchors>
          </Button>
          <Button name="$parentHandsSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="9">
            <Anchors><Anchor point="TOP" relativeTo="$parentWristSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentWaistSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="5">
            <Anchors><Anchor point="TOP" relativeTo="$parentHandsSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentLegsSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="6">
            <Anchors><Anchor point="TOP" relativeTo="$parentWaistSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>
          <Button name="$parentFeetSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="7">
            <Anchors><Anchor point="TOP" relativeTo="$parentLegsSlot" relativePoint="BOTTOM"><Offset x="0" y="-7" /></Anchor></Anchors>
          </Button>

          <!-- Weapons follow Blizzard's horizontal main/off/ranged treatment. -->
          <Button name="$parentMainHandSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="11">
            <Anchors><Anchor point="BOTTOM"><Offset x="-48" y="47" /></Anchor></Anchors>
          </Button>
          <Button name="$parentSecondaryHandSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="12">
            <Anchors><Anchor point="LEFT" relativeTo="$parentMainHandSlot" relativePoint="RIGHT"><Offset x="7" y="0" /></Anchor></Anchors>
          </Button>
          <Button name="$parentRangedSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="13">
            <Anchors><Anchor point="LEFT" relativeTo="$parentSecondaryHandSlot" relativePoint="RIGHT"><Offset x="7" y="0" /></Anchor></Anchors>
          </Button>

          <Button name="$parentRotateLeft">
            <Size x="32" y="32" /><Anchors><Anchor point="BOTTOMLEFT"><Offset x="14" y="9" /></Anchor></Anchors>
            <Scripts><OnClick>NativeTransmog_Rotate(-0.20);</OnClick></Scripts>
            <NormalTexture file="Interface\Buttons\UI-RotationLeft-Button-Up" />
            <PushedTexture file="Interface\Buttons\UI-RotationLeft-Button-Down" />
            <HighlightTexture file="Interface\Buttons\ButtonHilight-Round" alphaMode="ADD" />
          </Button>
          <Button name="$parentReset" inherits="UIPanelButtonTemplate" text="Reset Preview">
            <Size x="112" y="22" /><Anchors><Anchor point="BOTTOM"><Offset x="0" y="13" /></Anchor></Anchors>
            <Scripts><OnClick>NativeTransmog_ResetPreview();</OnClick></Scripts>
          </Button>
          <Button name="$parentRotateRight">
            <Size x="32" y="32" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-14" y="9" /></Anchor></Anchors>
            <Scripts><OnClick>NativeTransmog_Rotate(0.20);</OnClick></Scripts>
            <NormalTexture file="Interface\Buttons\UI-RotationRight-Button-Up" />
            <PushedTexture file="Interface\Buttons\UI-RotationRight-Button-Down" />
            <HighlightTexture file="Interface\Buttons\ButtonHilight-Round" alphaMode="ADD" />
          </Button>
        </Frames>
      </Frame>

      <Frame name="$parentBrowserPanel">
        <Size x="408" y="292" />
        <Anchors><Anchor point="TOPLEFT"><Offset x="458" y="-140" /></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4" /></BackgroundInsets>
          <TileSize><AbsValue val="16" /></TileSize>
          <EdgeSize><AbsValue val="16" /></EdgeSize>
        </Backdrop>
        <Frames>
          <ScrollFrame name="$parentScroll" inherits="UIPanelScrollFrameTemplate">
            <Size x="365" y="260" /><Anchors><Anchor point="TOPLEFT"><Offset x="10" y="-12" /></Anchor></Anchors>
            <ScrollChild><Frame name="$parentChild"><Size x="365" y="260" /></Frame></ScrollChild>
          </ScrollFrame>
        </Frames>
      </Frame>
      <Button name="$parentPrevious" inherits="UIPanelButtonTemplate" text="Previous">
        <Size x="78" y="22" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-330" y="78" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_PreviousPage();</OnClick></Scripts>
      </Button>
      <Button name="$parentNext" inherits="UIPanelButtonTemplate" text="Next">
        <Size x="78" y="22" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-247" y="78" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_NextPage();</OnClick></Scripts>
      </Button>
      <Button name="$parentApply" inherits="UIPanelButtonTemplate" text="Apply Appearance">
        <Size x="145" y="22" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-173" y="47" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_Apply();</OnClick></Scripts>
      </Button>
      <Button name="$parentRemove" inherits="UIPanelButtonTemplate" text="Remove Appearance">
        <Size x="145" y="22" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-20" y="47" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_Remove();</OnClick></Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>NativeTransmog_OnLoad(self);</OnLoad>
      <OnEvent>NativeTransmog_OnEvent(self, event, ...);</OnEvent>
      <OnShow>NativeTransmog_OnShow(self);</OnShow>
      <OnHide>NativeTransmog_OnHide(self);</OnHide>
      <OnUpdate>NativeTransmog_FrameUpdate();</OnUpdate>
      <OnDragStart>self:StartMoving();</OnDragStart>
      <OnDragStop>self:StopMovingOrSizing();</OnDragStop>
    </Scripts>
  </Frame>
</Ui>
