<?xml version="1.0" encoding="utf-8"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Script file="NativeTransmogFrame.lua" />

  <!-- WotLK's CharacterFrame tab template uses a blue locked highlight for the
       selected state. Collections uses the gold OptionsFrame active art and a
       dark inactive state, matching the supplied retail references. -->
  <Button name="NativeTransmogCollectionsTabTemplate" virtual="true">
    <Size x="70" y="25" />
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentLeftInactive" file="Interface\OptionsFrame\UI-OptionsFrame-InActiveTab">
          <Size x="20" y="24" /><Anchors><Anchor point="TOPLEFT" /></Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1" />
        </Texture>
        <Texture name="$parentRightInactive" file="Interface\OptionsFrame\UI-OptionsFrame-InActiveTab">
          <Size x="20" y="24" /><Anchors><Anchor point="TOPRIGHT" /></Anchors>
          <TexCoords left="0.84375" right="1" top="0" bottom="1" />
        </Texture>
        <Texture name="$parentMiddleInactive" file="Interface\OptionsFrame\UI-OptionsFrame-InActiveTab">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parentLeftInactive" relativePoint="TOPRIGHT" />
            <Anchor point="BOTTOMRIGHT" relativeTo="$parentRightInactive" relativePoint="BOTTOMLEFT" />
          </Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1" />
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture name="$parentLeftSelected" file="Interface\OptionsFrame\UI-OptionsFrame-ActiveTab" hidden="true">
          <Size x="20" y="24" /><Anchors><Anchor point="TOPLEFT"><Offset x="0" y="2" /></Anchor></Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1" />
        </Texture>
        <Texture name="$parentRightSelected" file="Interface\OptionsFrame\UI-OptionsFrame-ActiveTab" hidden="true">
          <Size x="20" y="24" /><Anchors><Anchor point="TOPRIGHT"><Offset x="0" y="2" /></Anchor></Anchors>
          <TexCoords left="0.84375" right="1" top="0" bottom="1" />
        </Texture>
        <Texture name="$parentMiddleSelected" file="Interface\OptionsFrame\UI-OptionsFrame-ActiveTab" hidden="true">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parentLeftSelected" relativePoint="TOPRIGHT" />
            <Anchor point="BOTTOMRIGHT" relativeTo="$parentRightSelected" relativePoint="BOTTOMLEFT" />
          </Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1" />
        </Texture>
      </Layer>
    </Layers>
    <ButtonText name="$parentText">
      <Anchors><Anchor point="CENTER"><Offset x="0" y="0" /></Anchor></Anchors>
    </ButtonText>
    <NormalFont style="GameFontNormalSmall" />
    <HighlightFont style="GameFontHighlightSmall" />
    <DisabledFont style="GameFontDisableSmall" />
    <HighlightTexture file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight-yellow" alphaMode="ADD">
      <Anchors>
        <Anchor point="TOPLEFT"><Offset x="8" y="0" /></Anchor>
        <Anchor point="BOTTOMRIGHT"><Offset x="-8" y="2" /></Anchor>
      </Anchors>
    </HighlightTexture>
  </Button>

  <!-- ItemButtonTemplate supplies Blizzard's 37px icon, count, and highlight conventions. Its
       UI-Quickslot2 normal texture is cleared on load so equipment artwork has the same clean treatment
       as other wardrobe icons. The wardrobe owns only selection and confirmed-override markers; it
       intentionally does not inherit PaperDollItemSlotButtonTemplate's CharacterFrame handlers. -->
  <Button name="NativeTransmogEquipmentSlotTemplate" inherits="ItemButtonTemplate" virtual="true">
    <Size x="40" y="40" />
    <Layers>
      <Layer level="OVERLAY">
        <Texture name="$parentSelection" file="Interface\Buttons\CheckButtonHilight" alphaMode="ADD" hidden="true">
          <Size x="50" y="50" /><Anchors><Anchor point="CENTER" /></Anchors>
        </Texture>
        <Texture name="$parentTransmogMark" file="Interface\RaidFrame\ReadyCheck-Ready" hidden="true">
          <Size x="15" y="15" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-1" y="1" /></Anchor></Anchors>
        </Texture>
        <Texture name="$parentHiddenMark" file="Interface\Buttons\UI-GroupLoot-Pass-Up" hidden="true">
          <Size x="17" y="17" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="0" y="0" /></Anchor></Anchors>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>NativeTransmog_EquipmentSlot_OnLoad(self);</OnLoad>
      <OnClick>NativeTransmog_EquipmentSlot_OnClick(self);</OnClick>
      <OnEnter>NativeTransmog_EquipmentSlot_OnEnter(self);</OnEnter>
      <OnLeave>NativeTransmog_EquipmentSlot_OnLeave(self);</OnLeave>
    </Scripts>
  </Button>

  <Frame name="NativeTransmogFrame" parent="UIParent" hidden="true"
      enableMouse="true" movable="true" frameStrata="DIALOG" toplevel="true">
    <Size x="960" y="600" />
    <Anchors><Anchor point="CENTER" /></Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark"
        edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets><AbsInset left="7" right="7" top="7" bottom="7" /></BackgroundInsets>
      <TileSize><AbsValue val="32" /></TileSize>
      <EdgeSize><AbsValue val="24" /></EdgeSize>
    </Backdrop>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentLeftBackground"><Color r="0.025" g="0.027" b="0.035" a="0.96" />
          <Anchors><Anchor point="TOPLEFT"><Offset x="8" y="-31" /></Anchor><Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT"><Offset x="300" y="8" /></Anchor></Anchors>
        </Texture>
        <Texture name="$parentBrowserBackground"><Color r="0.105" g="0.082" b="0.050" a="0.97" />
          <Anchors><Anchor point="TOPLEFT"><Offset x="305" y="-31" /></Anchor><Anchor point="BOTTOMRIGHT"><Offset x="-8" y="8" /></Anchor></Anchors>
        </Texture>
        <Texture name="$parentTitleStrip"><Color r="0.035" g="0.038" b="0.041" a="1" />
          <Anchors><Anchor point="TOPLEFT"><Offset x="8" y="-8" /></Anchor><Anchor point="TOPRIGHT"><Offset x="-8" y="-8" /></Anchor></Anchors><Size y="23" />
        </Texture>
        <Texture name="$parentSectionSeparator"><Color r="0.34" g="0.27" b="0.16" a="0.9" />
          <Size x="2" /><Anchors><Anchor point="TOPLEFT"><Offset x="303" y="-31" /></Anchor><Anchor point="BOTTOMLEFT"><Offset x="303" y="8" /></Anchor></Anchors>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" inherits="GameFontNormal" text="Transmogrify">
          <Anchors><Anchor point="TOP"><Offset x="0" y="-12" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentSlotTitle" inherits="GameFontNormalLarge" justifyH="LEFT">
          <Size x="290" y="20" /><Anchors><Anchor point="TOPLEFT"><Offset x="318" y="-77" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentHint" inherits="GameFontDisableSmall" justifyH="LEFT" text="Select an appearance to preview it">
          <Size x="290" y="14" /><Anchors><Anchor point="TOPLEFT"><Offset x="318" y="-98" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentActual" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size x="264" y="12" /><Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentPreviewPanel" relativePoint="BOTTOMLEFT"><Offset x="10" y="43" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentApplied" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size x="264" y="12" /><Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentPreviewPanel" relativePoint="BOTTOMLEFT"><Offset x="10" y="28" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentPreview" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size x="264" y="12" /><Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentPreviewPanel" relativePoint="BOTTOMLEFT"><Offset x="10" y="13" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentStatus" inherits="GameFontNormalSmall" justifyH="CENTER">
          <Size x="410" y="16" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-18" y="15" /></Anchor></Anchors>
        </FontString>
      </Layer>
      <Layer level="OVERLAY">
        <!-- UI-DialogBox-Gold-Border is a nine-slice edge atlas, not four corner
             quadrants. Header end-caps provide complete 3.3.5a gold flourishes. -->
        <Texture name="$parentBrowserCornerTL" file="Interface\DialogFrame\UI-DialogBox-Header" alpha="0.72"><Size x="90" y="44" /><Anchors><Anchor point="TOPLEFT"><Offset x="307" y="-70" /></Anchor></Anchors><TexCoords left="0" right="0.28" top="0" bottom="1" /></Texture>
        <Texture name="$parentBrowserCornerTR" file="Interface\DialogFrame\UI-DialogBox-Header" alpha="0.72"><Size x="90" y="44" /><Anchors><Anchor point="TOPRIGHT"><Offset x="-10" y="-70" /></Anchor></Anchors><TexCoords left="1" right="0.72" top="0" bottom="1" /></Texture>
        <Texture name="$parentBrowserCornerBL" file="Interface\DialogFrame\UI-DialogBox-Header" alpha="0.72"><Size x="90" y="44" /><Anchors><Anchor point="BOTTOMLEFT"><Offset x="307" y="10" /></Anchor></Anchors><TexCoords left="0" right="0.28" top="1" bottom="0" /></Texture>
        <Texture name="$parentBrowserCornerBR" file="Interface\DialogFrame\UI-DialogBox-Header" alpha="0.72"><Size x="90" y="44" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-10" y="10" /></Anchor></Anchors><TexCoords left="1" right="0.72" top="1" bottom="0" /></Texture>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
        <Anchors><Anchor point="TOPRIGHT"><Offset x="-5" y="-5" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmogFrame:Hide();</OnClick></Scripts>
      </Button>
      <Frame name="$parentActualTooltip" enableMouse="true">
        <Size x="264" y="12" /><Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentPreviewPanel" relativePoint="BOTTOMLEFT"><Offset x="10" y="43" /></Anchor></Anchors>
        <Scripts><OnEnter>NativeTransmog_StateLabel_OnEnter(self,"ACTUAL");</OnEnter><OnLeave>GameTooltip:Hide();</OnLeave></Scripts>
      </Frame>
      <Frame name="$parentAppliedTooltip" enableMouse="true">
        <Size x="264" y="12" /><Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentPreviewPanel" relativePoint="BOTTOMLEFT"><Offset x="10" y="28" /></Anchor></Anchors>
        <Scripts><OnEnter>NativeTransmog_StateLabel_OnEnter(self,"APPLIED");</OnEnter><OnLeave>GameTooltip:Hide();</OnLeave></Scripts>
      </Frame>
      <Frame name="$parentPreviewTooltip" enableMouse="true">
        <Size x="264" y="12" /><Anchors><Anchor point="BOTTOMLEFT" relativeTo="$parentPreviewPanel" relativePoint="BOTTOMLEFT"><Offset x="10" y="13" /></Anchor></Anchors>
        <Scripts><OnEnter>NativeTransmog_StateLabel_OnEnter(self,"PREVIEW");</OnEnter><OnLeave>GameTooltip:Hide();</OnLeave></Scripts>
      </Frame>
      <Frame name="$parentPreviewPanel">
        <Size x="284" y="474" />
        <Anchors><Anchor point="TOPLEFT"><Offset x="12" y="-91" /></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4" /></BackgroundInsets>
          <TileSize><AbsValue val="16" /></TileSize>
          <EdgeSize><AbsValue val="16" /></EdgeSize>
        </Backdrop>
        <Layers>
          <Layer level="BACKGROUND">
            <!-- Four stock WotLK dressing-room pieces are assigned for the
                 player's race by NativeTransmog_PreviewPanel_OnLoad. -->
            <Texture name="$parentBackgroundTopLeft"><Size x="222" y="273" /><Anchors><Anchor point="TOPLEFT"><Offset x="4" y="-4" /></Anchor></Anchors></Texture>
            <Texture name="$parentBackgroundTopRight"><Size x="54" y="273" /><Anchors><Anchor point="TOPLEFT" relativeTo="$parentBackgroundTopLeft" relativePoint="TOPRIGHT" /></Anchors></Texture>
            <Texture name="$parentBackgroundBotLeft"><Size x="222" y="137" /><Anchors><Anchor point="TOPLEFT" relativeTo="$parentBackgroundTopLeft" relativePoint="BOTTOMLEFT" /></Anchors></Texture>
            <Texture name="$parentBackgroundBotRight"><Size x="54" y="137" /><Anchors><Anchor point="TOPLEFT" relativeTo="$parentBackgroundTopRight" relativePoint="BOTTOMLEFT" /></Anchors></Texture>
            <Texture name="$parentBackgroundShade"><Color r="0.015" g="0.018" b="0.026" a="0.30" /><Anchors><Anchor point="TOPLEFT"><Offset x="4" y="-4" /></Anchor><Anchor point="BOTTOMRIGHT"><Offset x="-4" y="4" /></Anchor></Anchors></Texture>
            <Texture name="$parentStateBackground"><Color r="0.018" g="0.020" b="0.027" a="0.90" /><Size x="274" y="54" /><Anchors><Anchor point="BOTTOM"><Offset x="0" y="5" /></Anchor></Anchors></Texture>
          </Layer>
        </Layers>
        <Frames>
          <DressUpModel name="$parentModel" enableMouse="true" enableMouseWheel="true">
            <Size x="196" y="382" />
            <Anchors><Anchor point="TOP"><Offset x="0" y="-12" /></Anchor></Anchors>
            <Scripts>
              <OnMouseDown>NativeTransmog_BeginRotation(self);</OnMouseDown>
              <OnMouseUp>NativeTransmog_EndRotation(self);</OnMouseUp>
              <OnHide>NativeTransmog_EndRotation(self);</OnHide>
              <OnUpdate>NativeTransmog_UpdateRotation(self);</OnUpdate>
              <OnMouseWheel>NativeTransmog_Rotate(delta * .12);</OnMouseWheel>
            </Scripts>
          </DressUpModel>

          <!-- Left paper-doll column. -->
          <Button name="$parentHeadSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="1">
            <Anchors><Anchor point="TOPLEFT"><Offset x="7" y="-35" /></Anchor></Anchors>
          </Button>
          <Button name="$parentShoulderSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="2">
            <Anchors><Anchor point="TOP" relativeTo="$parentHeadSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentBackSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="10">
            <Anchors><Anchor point="TOP" relativeTo="$parentShoulderSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentChestSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="4">
            <Anchors><Anchor point="TOP" relativeTo="$parentBackSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentShirtSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="3">
            <Anchors><Anchor point="TOP" relativeTo="$parentChestSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentTabardSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="14">
            <Anchors><Anchor point="TOP" relativeTo="$parentShirtSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>

          <!-- Right paper-doll column. -->
          <Button name="$parentWristSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="8">
            <Anchors><Anchor point="TOPRIGHT"><Offset x="-7" y="-83" /></Anchor></Anchors>
          </Button>
          <Button name="$parentHandsSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="9">
            <Anchors><Anchor point="TOP" relativeTo="$parentWristSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentWaistSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="5">
            <Anchors><Anchor point="TOP" relativeTo="$parentHandsSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentLegsSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="6">
            <Anchors><Anchor point="TOP" relativeTo="$parentWaistSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>
          <Button name="$parentFeetSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="7">
            <Anchors><Anchor point="TOP" relativeTo="$parentLegsSlot" relativePoint="BOTTOM"><Offset x="0" y="-8" /></Anchor></Anchors>
          </Button>

          <!-- Weapons follow Blizzard's horizontal main/off/ranged treatment. -->
          <Button name="$parentMainHandSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="11">
            <Anchors><Anchor point="BOTTOM"><Offset x="-48" y="104" /></Anchor></Anchors>
          </Button>
          <Button name="$parentSecondaryHandSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="12">
            <Anchors><Anchor point="LEFT" relativeTo="$parentMainHandSlot" relativePoint="RIGHT"><Offset x="7" y="0" /></Anchor></Anchors>
          </Button>
          <Button name="$parentRangedSlot" inherits="NativeTransmogEquipmentSlotTemplate" id="13">
            <Anchors><Anchor point="LEFT" relativeTo="$parentSecondaryHandSlot" relativePoint="RIGHT"><Offset x="7" y="0" /></Anchor></Anchors>
          </Button>

          <Button name="$parentRotateLeft">
            <Size x="32" y="32" /><Anchors><Anchor point="BOTTOMLEFT"><Offset x="14" y="66" /></Anchor></Anchors>
            <Scripts><OnClick>NativeTransmog_Rotate(-0.20);</OnClick></Scripts>
            <NormalTexture file="Interface\Buttons\UI-RotationLeft-Button-Up" />
            <PushedTexture file="Interface\Buttons\UI-RotationLeft-Button-Down" />
            <HighlightTexture file="Interface\Buttons\ButtonHilight-Round" alphaMode="ADD" />
          </Button>
          <Button name="$parentReset" inherits="UIPanelButtonTemplate" text="Reset Preview">
            <Size x="112" y="22" /><Anchors><Anchor point="TOPRIGHT"><Offset x="-8" y="-8" /></Anchor></Anchors>
            <Scripts><OnClick>NativeTransmog_ResetPreview();</OnClick></Scripts>
          </Button>
          <Button name="$parentRotateRight">
            <Size x="32" y="32" /><Anchors><Anchor point="BOTTOMRIGHT"><Offset x="-14" y="66" /></Anchor></Anchors>
            <Scripts><OnClick>NativeTransmog_Rotate(0.20);</OnClick></Scripts>
            <NormalTexture file="Interface\Buttons\UI-RotationRight-Button-Up" />
            <PushedTexture file="Interface\Buttons\UI-RotationRight-Button-Down" />
            <HighlightTexture file="Interface\Buttons\ButtonHilight-Round" alphaMode="ADD" />
          </Button>
        </Frames>
        <Scripts><OnLoad>NativeTransmog_PreviewPanel_OnLoad(self);</OnLoad></Scripts>
      </Frame>

      <Frame name="$parentBrowserPanel">
        <Size x="622" y="354" />
        <Anchors><Anchor point="TOPLEFT"><Offset x="323" y="-124" /></Anchor></Anchors>
        <Frames>
          <ScrollFrame name="$parentScroll" inherits="UIPanelScrollFrameTemplate">
            <Size x="586" y="353" /><Anchors><Anchor point="TOPLEFT"><Offset x="0" y="0" /></Anchor></Anchors>
            <ScrollChild><Frame name="$parentChild"><Size x="566" y="353" /></Frame></ScrollChild>
          </ScrollFrame>
          <!-- Build 12340 does not expose SetClipsChildren. Keep one reusable,
               conservatively framed viewport on the fixed browser panel and
               move it over the selected Head tile only. -->
          <DressUpModel name="NativeTransmogCatalogPortraitModel" hidden="true" enableMouse="false">
            <Size x="84" y="111" />
            <Anchors><Anchor point="TOPLEFT" /></Anchors>
          </DressUpModel>
          <Button name="$parentPending" hidden="true" enableMouse="true">
            <Anchors>
              <Anchor point="TOPLEFT"><Offset x="5" y="-5" /></Anchor>
              <Anchor point="BOTTOMRIGHT"><Offset x="-5" y="5" /></Anchor>
            </Anchors>
            <Layers>
              <Layer level="BACKGROUND">
                <Texture name="$parentShade"><Color r="0" g="0" b="0" a="0.58" /><Anchors><Anchor point="TOPLEFT" /><Anchor point="BOTTOMRIGHT" /></Anchors></Texture>
              </Layer>
              <Layer level="OVERLAY">
                <FontString name="$parentText" inherits="GameFontHighlight" text="Waiting for server...">
                  <Anchors><Anchor point="CENTER"><Offset x="0" y="8" /></Anchor></Anchors>
                </FontString>
                <FontString name="$parentDetail" inherits="GameFontDisableSmall" text="Updating appearance catalog">
                  <Anchors><Anchor point="TOP" relativeTo="$parentText" relativePoint="BOTTOM"><Offset x="0" y="-5" /></Anchor></Anchors>
                </FontString>
              </Layer>
            </Layers>
          </Button>
          <Frame name="$parentEmpty" hidden="true">
            <Anchors>
              <Anchor point="TOPLEFT"><Offset x="18" y="-18" /></Anchor>
              <Anchor point="BOTTOMRIGHT"><Offset x="-18" y="18" /></Anchor>
            </Anchors>
            <Layers><Layer level="ARTWORK">
              <FontString name="$parentText" inherits="GameFontDisable" justifyH="CENTER" justifyV="MIDDLE">
                <Size x="500" y="56" /><Anchors><Anchor point="CENTER" /></Anchors>
              </FontString>
            </Layer></Layers>
          </Frame>
        </Frames>
      </Frame>
      <Button name="$parentPrevious" inherits="UIPanelButtonTemplate" text="&lt;">
        <Size x="28" y="22" /><Anchors><Anchor point="BOTTOM"><Offset x="18" y="39" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_PreviousPage();</OnClick></Scripts>
      </Button>
      <Frame name="$parentPage">
        <Size x="76" y="22" /><Anchors><Anchor point="LEFT" relativeTo="$parentPrevious" relativePoint="RIGHT"><Offset x="4" y="0" /></Anchor></Anchors>
        <Layers><Layer level="ARTWORK">
          <FontString name="$parentText" inherits="GameFontHighlightSmall" text="Page 1">
            <Anchors><Anchor point="CENTER" /></Anchors>
          </FontString>
        </Layer></Layers>
      </Frame>
      <Button name="$parentNext" inherits="UIPanelButtonTemplate" text="&gt;">
        <Size x="28" y="22" /><Anchors><Anchor point="LEFT" relativeTo="$parentPage" relativePoint="RIGHT"><Offset x="4" y="0" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_NextPage();</OnClick></Scripts>
      </Button>
      <Button name="$parentApply" inherits="UIPanelButtonTemplate" text="Apply Appearance">
        <Size x="132" y="24" /><Anchors><Anchor point="BOTTOMLEFT"><Offset x="12" y="7" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_Apply();</OnClick></Scripts>
      </Button>
      <Button name="$parentRemove" inherits="UIPanelButtonTemplate" text="Remove Appearance">
        <Size x="132" y="24" /><Anchors><Anchor point="LEFT" relativeTo="$parentApply" relativePoint="RIGHT"><Offset x="6" y="0" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_Remove();</OnClick></Scripts>
      </Button>
      <Frame name="$parentSavedSetDropDown" inherits="UIDropDownMenuTemplate">
        <Anchors><Anchor point="TOPLEFT"><Offset x="0" y="-40" /></Anchor></Anchors>
        <Scripts><OnLoad>NativeTransmog_SavedSetDropDown_OnLoad(self);</OnLoad></Scripts>
      </Frame>
      <Button name="$parentApplySavedSet" inherits="UIPanelButtonTemplate" text="Saved Sets..." hidden="true">
        <Size x="184" y="22" /><Anchors><Anchor point="TOPLEFT"><Offset x="12" y="-43" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmog_ToggleSavedSets(self);</OnClick></Scripts>
      </Button>
      <Button name="$parentSaveOutfit" inherits="UIPanelButtonTemplate" text="Save">
        <Size x="84" y="22" /><Anchors><Anchor point="TOPLEFT"><Offset x="208" y="-43" /></Anchor></Anchors>
        <Scripts><OnLoad>self:Disable();</OnLoad><OnEnter>NativeTransmog_DeferredControl_OnEnter(self,"Save outfits in the gold Collections window.");</OnEnter><OnLeave>GameTooltip:Hide();</OnLeave></Scripts>
      </Button>
      <Button name="$parentItemsTab" inherits="UIPanelButtonTemplate" text="Items">
        <Size x="70" y="24" /><Anchors><Anchor point="TOPLEFT"><Offset x="319" y="-43" /></Anchor></Anchors><Scripts><OnLoad>self:Disable();</OnLoad></Scripts>
      </Button>
      <Button name="$parentSetsTab" inherits="UIPanelButtonTemplate" text="Sets">
        <Size x="70" y="24" /><Anchors><Anchor point="LEFT" relativeTo="$parentItemsTab" relativePoint="RIGHT"><Offset x="4" y="0" /></Anchor></Anchors><Scripts><OnClick>NativeTransmog_ToggleSavedSets(NativeTransmogFrameApplySavedSet);</OnClick></Scripts>
      </Button>
      <StatusBar name="$parentProgress">
        <Size x="200" y="13" /><Anchors><Anchor point="TOP"><Offset x="104" y="-49" /></Anchor></Anchors><BarTexture file="Interface\TargetingFrame\UI-StatusBar" /><BarColor r="0.18" g="0.32" b="0.15" a="1" />
        <Layers><Layer level="OVERLAY"><FontString name="$parentText" inherits="GameFontDisableSmall" text="Progress in Collections"><Anchors><Anchor point="CENTER" /></Anchors></FontString></Layer></Layers>
      </StatusBar>
