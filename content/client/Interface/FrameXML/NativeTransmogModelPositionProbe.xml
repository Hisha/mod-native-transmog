<?xml version="1.0" encoding="utf-8"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Script file="NativeTransmogModelPositionProbe.lua" />

  <!-- Temporary PTR-only diagnostic. It is deliberately independent of every
       Wardrobe and Collections frame and is activated only by its slash command. -->
  <Frame name="NativeTransmogModelPositionProbe" parent="UIParent" hidden="true"
      enableMouse="true" movable="true" frameStrata="DIALOG" toplevel="true">
    <Size x="738" y="370" />
    <Anchors><Anchor point="CENTER" /></Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark"
        edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets><AbsInset left="7" right="7" top="7" bottom="7" /></BackgroundInsets>
      <TileSize><AbsValue val="32" /></TileSize>
      <EdgeSize><AbsValue val="24" /></EdgeSize>
    </Backdrop>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" inherits="GameFontNormalLarge"
            text="Native Transmog Model Position Diagnostic">
          <Anchors><Anchor point="TOP"><Offset x="0" y="-14" /></Anchor></Anchors>
        </FontString>
        <FontString name="$parentHint" inherits="GameFontDisableSmall"
            text="Identical player, item, camera, facing, scale, and timing; requested Z is the only variable">
          <Anchors><Anchor point="TOP"><Offset x="0" y="-34" /></Anchor></Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
        <Anchors><Anchor point="TOPRIGHT"><Offset x="-5" y="-5" /></Anchor></Anchors>
        <Scripts><OnClick>NativeTransmogModelPositionProbe:Hide();</OnClick></Scripts>
      </Button>

      <Frame name="$parentNegativePanel">
        <Size x="226" y="322" />
        <Anchors><Anchor point="BOTTOMLEFT"><Offset x="20" y="15" /></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4" /></BackgroundInsets>
          <TileSize><AbsValue val="16" /></TileSize><EdgeSize><AbsValue val="16" /></EdgeSize>
        </Backdrop>
        <Layers><Layer level="OVERLAY">
          <FontString name="$parentLabel" inherits="GameFontNormal" text="Negative Z  (0, -0.13, -2)">
            <Anchors><Anchor point="TOP"><Offset x="0" y="-5" /></Anchor></Anchors>
          </FontString>
        </Layer></Layers>
        <Frames><DressUpModel name="NativeTransmogModelPositionProbeNegativeModel">
          <Size x="220" y="300" /><Anchors><Anchor point="BOTTOM" /></Anchors>
        </DressUpModel></Frames>
      </Frame>

      <Frame name="$parentDefaultPanel">
        <Size x="226" y="322" />
        <Anchors><Anchor point="LEFT" relativeTo="$parentNegativePanel" relativePoint="RIGHT"><Offset x="10" y="0" /></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4" /></BackgroundInsets>
          <TileSize><AbsValue val="16" /></TileSize><EdgeSize><AbsValue val="16" /></EdgeSize>
        </Backdrop>
        <Layers><Layer level="OVERLAY">
          <FontString name="$parentLabel" inherits="GameFontNormal" text="Default Z  (0, -0.13, 0)">
            <Anchors><Anchor point="TOP"><Offset x="0" y="-5" /></Anchor></Anchors>
          </FontString>
        </Layer></Layers>
        <Frames><DressUpModel name="NativeTransmogModelPositionProbeDefaultModel">
          <Size x="220" y="300" /><Anchors><Anchor point="BOTTOM" /></Anchors>
        </DressUpModel></Frames>
      </Frame>

      <Frame name="$parentPositivePanel">
        <Size x="226" y="322" />
        <Anchors><Anchor point="LEFT" relativeTo="$parentDefaultPanel" relativePoint="RIGHT"><Offset x="10" y="0" /></Anchor></Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4" /></BackgroundInsets>
          <TileSize><AbsValue val="16" /></TileSize><EdgeSize><AbsValue val="16" /></EdgeSize>
        </Backdrop>
        <Layers><Layer level="OVERLAY">
          <FontString name="$parentLabel" inherits="GameFontNormal" text="Positive Z  (0, -0.13, +2)">
            <Anchors><Anchor point="TOP"><Offset x="0" y="-5" /></Anchor></Anchors>
          </FontString>
        </Layer></Layers>
        <Frames><DressUpModel name="NativeTransmogModelPositionProbePositiveModel">
          <Size x="220" y="300" /><Anchors><Anchor point="BOTTOM" /></Anchors>
        </DressUpModel></Frames>
      </Frame>
    </Frames>
    <Scripts>
      <OnHide>NativeTransmog_ModelPositionProbe_OnHide(self);</OnHide>
    </Scripts>
  </Frame>
</Ui>
