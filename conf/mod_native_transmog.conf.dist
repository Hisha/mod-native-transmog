[worldserver]

#
#    NativeTransmog.Enable
#        Description: Enables the native preview wardrobe, NPC service,
#                     collection, and appearance application.
#        Default:     1

NativeTransmog.Enable = 1

#
#    NativeTransmog.DefaultNPC.Enable
#        Description: Enables service resolution for the module's dedicated
#                     module-owned Warpweaver entry 14999992.
#                     Its template and nine defaults are installed once by the
#                     normal world database updater.
#        Default:     1

NativeTransmog.DefaultNPC.Enable = 1

#
#    NativeTransmog.CustomNPC.Enable
#        Description: Enables database-registered creature entries and spawns.
#        Default:     1

NativeTransmog.CustomNPC.Enable = 1

#
#    NativeTransmog.CustomNPC.AllowSpawnRegistration
#        Description: Enables registration of individual persistent spawn IDs.
#        Default:     1

NativeTransmog.CustomNPC.AllowSpawnRegistration = 1

#
#    NativeTransmog.Collection.Enable
#        Description: Enables persistent appearance collection.
#        Default:     1

NativeTransmog.Collection.Enable = 1

#
#    NativeTransmog.Collection.AccountWide
#        Description: 1 shares appearances among characters on the authenticated
#                     account in this character database. 0 uses independent
#                     character collections. Switching preserves both scopes.
#        Default:     1

NativeTransmog.Collection.AccountWide = 1

#
#    NativeTransmog.Collection.UnlockOnAcquire
#        Description: Unlocks eligible armor and weapon appearances as items
#                     enter a character's ownership.
#        Default:     1

NativeTransmog.Collection.UnlockOnAcquire = 1

#
#    NativeTransmog.Collection.UnlockAllQuestRewards
#        Description: Unlocks every eligible selectable and guaranteed item
#                     appearance after a quest reward completes successfully.
#                     This never grants unselected items.
#        Default:     1

NativeTransmog.Collection.UnlockAllQuestRewards = 1

#
#    NativeTransmog.Collection.QuestBackfill.Enable
#        Description: Permits an authorized GM to explicitly preview or run a
#                     bounded historical quest-reward backfill. No scan starts
#                     on login, startup, reload, or a timer.
#        Default:     1

NativeTransmog.Collection.QuestBackfill.Enable = 1

#
#    NativeTransmog.Application.Enable
#        Description: Enables server-authorized application, persistence, and
#                     visible rendering of collected appearances. Disable this
#                     for a safe module-level rendering rollback.
#        Default:     1

NativeTransmog.Application.Enable = 1

#
#    NativeTransmog.AllowTwoHandAppearanceOnOneHand
#        Description: Permits a collected two-handed axe/mace/sword appearance
#                     on the corresponding one-handed weapon family.
#        Default:     0

NativeTransmog.AllowTwoHandAppearanceOnOneHand = 0

#
#    NativeTransmog.AllowOneHandAppearanceOnTwoHand
#        Description: Permits a collected one-handed axe/mace/sword appearance
#                     on the corresponding two-handed weapon family.
#        Default:     0

NativeTransmog.AllowOneHandAppearanceOnTwoHand = 0

#
#    NativeTransmog.HideWeapons
#        Description: Allow main-hand, off-hand (including shields and held
#                     items), and ranged equipment to be hidden.
#        Default:     0

NativeTransmog.HideWeapons = 0

#
#    NativeTransmog.Wardrobe.PageSize
#        Description: Maximum compatible appearances returned per requested page.
#        Range:       1-36 (values are clamped).
#        Default:     24

NativeTransmog.Wardrobe.PageSize = 24

#
#    NativeTransmog.Wardrobe.RequestCooldownMs
#        Description: Minimum interval between protected-FrameXML wardrobe requests.
#        Range:       0-5000 milliseconds (values are clamped).
#        Default:     250

NativeTransmog.Wardrobe.RequestCooldownMs = 250

#
#    NativeTransmog.Wardrobe.SnapshotLifetimeMs
#        Description: Lifetime of a server-bound catalog snapshot used by Apply/Remove.
#        Range:       5000-120000 milliseconds (values are clamped).
#        Default:     30000

NativeTransmog.Wardrobe.SnapshotLifetimeMs = 30000

#
#    NativeTransmog.CustomSets.Enable
#        Description: Enables character-owned custom appearance-set persistence,
#                     editing, preview, and NPC-gated application.
#        Default:     1

NativeTransmog.CustomSets.Enable = 1

#
#    NativeTransmog.CustomSets.MaximumPerCharacter
#        Description: Maximum saved custom sets owned by one character.
#        Range:       1-100 (values are clamped).
#        Default:     20

NativeTransmog.CustomSets.MaximumPerCharacter = 20

#
#    NativeTransmog.CustomSets.MaximumNameBytes
#        Description: Maximum UTF-8 byte length after surrounding whitespace is trimmed.
#        Range:       8-96 (values are clamped).
#        Default:     48

NativeTransmog.CustomSets.MaximumNameBytes = 48
